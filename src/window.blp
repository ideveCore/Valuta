using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  width-request: 350;
  height-request: 300;
  default-width: 420;
  default-height: 600;
  title: _("Valuta");
  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [end]
      MenuButton menu_button {
        primary: true;
        menu-model: primary_menu;
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main menu");
      }
    }
    content: Adw.Bin content {};
    [bottom]
    Gtk.Box {
      styles ["toolbar"]
      orientation: vertical;
      spacing: 1;
      margin-top: 6;
      margin-bottom: 6;

      Gtk.Revealer info_source_revealer {
        reveal-child: false;
        transition-type: slide_down;
        
        Gtk.Box {
          orientation: horizontal;
          halign: center;

          Gtk.Label info {
            styles ["dim-label"]
            label: _("");
          }

          Gtk.LinkButton source {
            tooltip-text: _("Source");
            visible: false;
          }
        }
      }

      Gtk.Revealer provider_warning_revealer {
        reveal-child: false;
        transition-type: slide_down;
        
        Gtk.Label provider_warning {
          styles ["dim-label"]
          halign: center;
          label: _("");
        }
      }
    }
  };
}

menu primary_menu {
  section {
    label: _('Providers');
    section {
      item {
        label: _("ECB");
        action: 'window.providers';
        target: 'ecb';
      }
      item {
        label: _("InforEuro");
        action: "window.providers";
        target: "inforeuro";
      }
    }
  }
  section {
    item {
      label: _("Keyboard shortcuts");
      action: "app.shortcuts";
    }
    item {
      label: _("About Valuta");
      action: "app.about";
    }
  }
}
